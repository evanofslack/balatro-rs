# ML training/eval workflow. Run from pylatro/ — needs .env/ set up first
# (see README.md: ./setup.sh, or maturin develop after any core/src change).

python := ".env/bin/python"
maturin := ".env/bin/maturin"

# rebuild the extension after a core/balatro-types/pylatro/src change
develop:
    {{maturin}} develop

# vanilla MCTS eval against the fixed 100-seed set
# saves results/mcts_<sims>_v<version>_s<seed>.json — seed is in the filename
# so re-running the same version at a different seed can't silently clobber
# an earlier run's saved results (bit us once already).
mcts version sims="100" seed="0" workers="1":
    {{python}} gym/eval.py --agent mcts --sims {{sims}} --agent-seed {{seed}} --workers {{workers}} --out results/mcts_{{sims}}_v{{version}}_s{{seed}}.json

# random baseline (floor)
random:
    {{python}} gym/eval.py --agent random --out results/random.json

# diff two saved eval.py --out runs
compare a b:
    {{python}} gym/compare.py {{a}} {{b}}

# average N same-version eval.py --out runs into one summary (see aggregate.py)
aggregate out *runs:
    {{python}} gym/aggregate.py {{runs}} --out {{out}}

# throughput numbers: steps/sec, episodes/sec, isolated clone() cost
bench:
    {{python}} gym/bench.py

tune n-trials="250" episodes="15" sims="100" workers="10":
    {{python}} gym/tune.py --n-trials {{n-trials}} --episodes-per-trial {{episodes}} --sims {{sims}} --workers {{workers}} --out results/tune_best.json --validate

tune-narrow best_json="results/tune_best.json" n-trials="75" episodes="60" sims="100" workers="10":
    {{python}} gym/tune.py --n-trials {{n-trials}} --episodes-per-trial {{episodes}} --sims {{sims}} --workers {{workers}} --warm-start {{best_json}} --out results/tune_best_narrow.json --validate

# re-run just the validation pass against a previously saved tune.py --out
tune-validate best_json workers="10":
    {{python}} gym/tune.py --validate-only {{best_json}} --workers {{workers}}

# pytest suite (gym/ + test_env.py + test_mcts_agent.py)
test:
    {{python}} -m pytest test/
